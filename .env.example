# Copy this file to .env and fill in the key(s) you're actually using.
# src/llm/client.py reads LLM_PROVIDER to select the provider.

# ── LLM provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=mistral          # mistral | groq | gemini

# Mistral AI (recommended for MemAge)
MISTRAL_API_KEY=replace_with_your_key
MISTRAL_MODEL=mistral-small-latest  # optional — default is mistral-small-latest

# Groq (free tier alternative)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192    # optional — default is llama3-8b-8192

# Gemini (Google AI Studio free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash  # optional — default is gemini-1.5-flash

# ── Vector store ───────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
